# =============================================================================
#  رِواق — environment configuration
#
#  Copy this file to `.env.local` (git-ignored) and fill in the two PUBLIC
#  values from your Supabase project:
#
#      Dashboard → Project Settings → API
#
#  ONLY the two variables below may ever be exposed to the browser. They are
#  inlined into the JavaScript bundle by Vite, therefore they must be the
#  *public* (anon / publishable) key only.
#
#  NEVER put the service-role key in this file, and never give it a `VITE_`
#  prefix. The application refuses to boot when it detects a privileged key
#  in a public variable (see src/config/env.ts).
# =============================================================================

# The URL of your Supabase project.
# Example: https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# The PUBLIC key of the project (anon key, or the newer publishable key).
# It is safe to ship to the browser: every row of data is protected by
# Row Level Security, so this key alone grants no access to anything.
# Example (legacy anon key): eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9....
VITE_SUPABASE_ANON_KEY=
